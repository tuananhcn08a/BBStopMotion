{
  "name": "neo-stopmotion-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --max-warnings 0 && tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/export.test.mjs",
    "e2e:camera": "node e2e/camera.test.mjs",
    "e2e:all": "node e2e/export.test.mjs && node e2e/camera.test.mjs",
    "verify": "node verify/gate.mjs",
    "verify:selftest": "node verify/gate.mjs --screen selftest --platform web --mockup verify/fixtures/self-test.html --app-url verify/fixtures/self-test.html --out-dir verify/.out/selftest-pass && node verify/gate.mjs --screen selftest-fail --platform web --mockup verify/fixtures/self-test.html --app-url verify/fixtures/self-test-fail.html --out-dir verify/.out/selftest-fail --expect-fail"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/ffmpeg": "0.12.10",
    "@ffmpeg/util": "0.12.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.2.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
