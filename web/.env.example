# Copy to .env.local and fill in real values. Never commit .env.local (see .gitignore).

# NAS upload endpoint — e.g. https://bb-share.bapbean.com/api/upload
VITE_UPLOAD_ENDPOINT=
# Shared upload token sent as X-Upload-Token header.
VITE_UPLOAD_TOKEN=

# Neo Steam embed (T-218) — allowlist origin host cho phép nhận PRACTICE_CONTEXT/PRACTICE_EVENT_ACK
# (comma-separated). Không set / để trống → app KHÔNG tin bất kỳ context nào (an toàn mặc định),
# không ảnh hưởng standalone. Xem src/lib/neoSteamEmbed.ts.
VITE_NEO_STEAM_ORIGINS=https://neo-steam.bapbean.com
